---
import Layout from "@/layouts/Layout.astro";

export const prerender = true;
---

<Layout title="Servicio no disponible">
  <main class="recovery-shell">
    <section class="recovery-card" aria-labelledby="recovery-title">
      <img
        class="brand-mark"
        src="/kogane.webp"
        alt="Kogane"
        width="62"
        height="62"
      />
      <p class="eyebrow">
        <span class="status-dot"></span> Conexión interrumpida
      </p>
      <h1 id="recovery-title">No pudimos conectar con Kogane</h1>
      <p class="description">
        La API está temporalmente fuera de servicio. Vuelve a cargar la vista en
        unos momentos.
      </p>
      <p class="notice">
        Si estabas enviando un formulario, es posible que el cambio no se haya
        guardado.
      </p>
      <form id="reload-form" class="actions">
        <button id="reload-view" class="primary-action" type="submit">
          <svg viewBox="0 0 24 24" aria-hidden="true"
            ><path d="M20 7v5h-5M4 17v-5h5"></path><path
              d="M5.5 9a7 7 0 0 1 11.8-2L20 12M4 12l2.7 5a7 7 0 0 0 11.8-2"
            ></path></svg
          >
          <span>Recargar la vista</span>
        </button>
        <a class="home-link" href="/">Ir al inicio</a>
      </form>
      <p class="help-text">
        Si el problema continúa, inténtalo de nuevo más tarde.
      </p>
    </section>
    <footer class="recovery-footer">Kogane · Finanzas personales</footer>
  </main>

  <style is:inline>
    :root {
      color-scheme: light dark;
      font-family:
        Inter,
        ui-sans-serif,
        system-ui,
        -apple-system,
        BlinkMacSystemFont,
        "Segoe UI",
        sans-serif;
    }
    *,
    *::before,
    *::after {
      box-sizing: border-box;
    }
    body {
      margin: 0;
      background: #f4f5f7;
      color: #18181b;
    }
    .recovery-shell {
      position: relative;
      min-height: 100svh;
      display: grid;
      place-items: center;
      padding: 28px 20px 48px;
      background:
        radial-gradient(
          ellipse at 50% 0%,
          rgba(59, 130, 246, 0.09),
          transparent 55%
        ),
        #f4f5f7;
    }
    .recovery-card {
      width: min(100%, 480px);
      padding: clamp(26px, 6vw, 42px);
      border: 1px solid #e4e4e7;
      border-radius: 22px;
      background: rgba(255, 255, 255, 0.94);
      box-shadow: 0 24px 70px rgba(24, 24, 27, 0.09);
    }
    .brand-mark {
      display: block;
      width: 54px;
      height: 54px;
      object-fit: contain;
    }
    .eyebrow {
      display: flex;
      align-items: center;
      gap: 9px;
      margin: 30px 0 10px;
      color: #71717a;
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 0.09em;
      text-transform: uppercase;
    }
    .status-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: #ef4444;
      box-shadow: 0 0 0 4px #fee2e2;
    }
    h1 {
      max-width: 360px;
      margin: 0;
      font-size: clamp(27px, 6vw, 34px);
      line-height: 1.12;
      letter-spacing: -0.04em;
    }
    .description {
      margin: 16px 0 0;
      color: #52525b;
      font-size: 15px;
      line-height: 1.65;
    }
    .notice {
      margin: 18px 0 0;
      padding: 12px 14px;
      border: 1px solid #e4e4e7;
      border-radius: 12px;
      background: #fafafa;
      color: #52525b;
      font-size: 13px;
      line-height: 1.5;
    }
    .actions {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 18px;
      margin-top: 24px;
    }
    .primary-action {
      display: inline-flex;
      min-height: 46px;
      align-items: center;
      justify-content: center;
      gap: 10px;
      padding: 0 18px;
      border: 0;
      border-radius: 12px;
      background: #18181b;
      color: #fff;
      font: inherit;
      font-size: 14px;
      font-weight: 650;
      cursor: pointer;
      transition:
        background 0.15s ease,
        transform 0.15s ease;
    }
    .primary-action:hover {
      background: #303036;
      transform: translateY(-1px);
    }
    .primary-action:focus-visible,
    .home-link:focus-visible {
      outline: 3px solid #60a5fa;
      outline-offset: 3px;
    }
    .primary-action:disabled {
      cursor: wait;
      opacity: 0.7;
    }
    .primary-action svg {
      width: 17px;
      height: 17px;
      fill: none;
      stroke: currentColor;
      stroke-linecap: round;
      stroke-linejoin: round;
      stroke-width: 1.8;
    }
    .home-link {
      color: #3f3f46;
      font-size: 14px;
      font-weight: 550;
      text-decoration: none;
    }
    .home-link:hover {
      text-decoration: underline;
      text-underline-offset: 4px;
    }
    .help-text {
      margin: 25px 0 0;
      color: #a1a1aa;
      font-size: 12px;
    }
    .recovery-footer {
      position: absolute;
      bottom: 13px;
      color: #a1a1aa;
      font-size: 11px;
    }
    :root.dark body {
      background: #09090b;
      color: #fafafa;
    }
    :root.dark .recovery-shell {
      background:
        radial-gradient(
          ellipse at 50% 0%,
          rgba(59, 130, 246, 0.14),
          transparent 55%
        ),
        #09090b;
    }
    :root.dark .recovery-card {
      border-color: #27272a;
      background: rgba(24, 24, 27, 0.95);
      box-shadow: 0 24px 70px rgba(0, 0, 0, 0.3);
    }
    :root.dark .primary-action {
      background: #fafafa;
      color: #18181b;
    }
    :root.dark .primary-action:hover {
      background: #e4e4e7;
    }
    :root.dark .notice {
      border-color: #3f3f46;
      background: #18181b;
      color: #d4d4d8;
    }
    :root.dark .description,
    :root.dark .home-link {
      color: #d4d4d8;
    }
    @media (max-width: 420px) {
      .actions {
        align-items: stretch;
        flex-direction: column;
        gap: 14px;
      }
      .home-link {
        text-align: center;
      }
    }
  </style>

  <script>
    const form = document.querySelector<HTMLFormElement>("#reload-form");
    const button = document.querySelector<HTMLButtonElement>("#reload-view");
    const buttonLabel = button?.querySelector("span");
    form?.addEventListener("submit", (event) => {
      event.preventDefault();
      if (button) button.disabled = true;
      if (buttonLabel) buttonLabel.textContent = "Recargando…";
      const requested = new URL(window.location.href).searchParams.get(
        "returnTo",
      );
      const destination = requested
        ? new URL(requested, window.location.origin)
        : null;
      const safePath =
        destination?.origin === window.location.origin
          ? `${destination.pathname}${destination.search}${destination.hash}`
          : "/";
      window.location.assign(safePath);
    });
  </script>
</Layout>
