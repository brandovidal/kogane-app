---
import DashboardLayout from "@/layouts/DashboardLayout.astro";
import { CardsPage } from "@/features/credit-cards/components/CardsPage";
import { CardPeriodSelector } from "@/features/credit-cards/components/header/CardPeriodSelector";
import { CardRecordCount } from "@/features/credit-cards/components/header/CardRecordCount";
import "@/features/credit-cards/styles/cards.css";
---

<DashboardLayout
  title="Tarjetas de crédito"
  section="Gastos"
  mainClass="app-gradient"
>
  <CardRecordCount slot="title-extra" client:load />
  <div slot="header-actions" class="hidden sm:block">
    <CardPeriodSelector client:load />
  </div>
  <CardsPage client:load />
</DashboardLayout>
