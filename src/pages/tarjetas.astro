---
import DashboardLayout from "@/layouts/DashboardLayout.astro";
import {
  CardsPage,
  CardPeriodSelector,
  CardRecordCount,
} from "@/features/credit-cards";
import "@/features/credit-cards/styles/cards.css";
---

<DashboardLayout
  title="Tarjetas de crédito"
  section="Gastos"
  mainClass="app-gradient"
>
  <CardRecordCount slot="title-extra" client:load />
  <div slot="header-actions" class="hidden sm:block">
    <CardPeriodSelector client:load />
  </div>
  <CardsPage client:load />
</DashboardLayout>
