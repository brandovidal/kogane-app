---
// The menu of D41 drawn at build time (D102): groups are <details>, the link of the current page is marked here and the
// only live piece is the counter of Borrador. Compact mode and remembered groups are CSS and a tiny script (Sidebar)
import { ChevronDown } from "lucide-react";

import { DEFAULT_OPEN_GROUPS, NAV, SETTINGS_NAV, isActivePath, isGroup, type NavLink } from "@/shared/constants";
import { NAV_ICONS } from "@/shared/nav-icons";
import { DraftCount } from "./DraftCount";

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;

const linkClass = (active: boolean) =>
  [
    "nav-link flex w-full items-center gap-3 rounded-lg px-3 py-2 text-sm font-medium transition-colors",
    "group-data-[compact=true]/sb:justify-center group-data-[compact=true]/sb:px-2",
    active
      ? "bg-sidebar-accent text-sidebar-accent-foreground"
      : "text-sidebar-foreground/70 hover:bg-sidebar-accent hover:text-sidebar-accent-foreground",
  ].join(" ");

const isCurrent = (link: NavLink) => isActivePath(link.href, currentPath);
---

<nav class="nav-menu flex-1 space-y-1 overflow-y-auto p-3">
  {
    NAV.map((entry) => {
      if (!isGroup(entry)) {
        const Icon = NAV_ICONS[entry.icon];
        return (
          <a href={entry.href} title={entry.label} class={linkClass(isCurrent(entry))} aria-current={isCurrent(entry) ? "page" : undefined}>
            <span class="relative"><Icon className="h-4 w-4" /></span>
            <span class="nav-label flex-1 group-data-[compact=true]/sb:hidden">{entry.label}</span>
          </a>
        );
      }

      const GroupIcon = NAV_ICONS[entry.icon];
      const holdsCurrent = entry.children.some(isCurrent);
      const open = DEFAULT_OPEN_GROUPS.includes(entry.label) || holdsCurrent;
      const hasDrafts = entry.children.some((child) => child.badge === "drafts");
      return (
        <details class="nav-group" data-group={entry.label} data-current={holdsCurrent ? "true" : undefined} open={open}>
          <summary class={`${linkClass(false)} cursor-pointer list-none group-data-[compact=true]/sb:hidden [&::-webkit-details-marker]:hidden`}>
            <GroupIcon className="h-4 w-4" />
            <span class="nav-label flex-1 text-left">{entry.label}</span>
            {/* a closed group keeps the counter of Borrador in sight */}
            {hasDrafts && <span class="nav-summary-badge"><DraftCount client:idle /></span>}
            <ChevronDown className="nav-chevron h-4 w-4 transition-transform" />
          </summary>
          <div class="space-y-1 ml-4 border-l border-sidebar-border pl-2 group-data-[compact=true]/sb:ml-0 group-data-[compact=true]/sb:border-0 group-data-[compact=true]/sb:pl-0">
            {entry.children.map((child) => {
              const Icon = NAV_ICONS[child.icon];
              return (
                <a href={child.href} title={child.label} class={linkClass(isCurrent(child))} aria-current={isCurrent(child) ? "page" : undefined}>
                  <span class="relative">
                    <Icon className="h-4 w-4" />
                    {child.badge === "drafts" && <DraftCount dot client:idle />}
                  </span>
                  <span class="nav-label flex-1 group-data-[compact=true]/sb:hidden">{child.label}</span>
                  {child.badge === "drafts" && <span class="nav-pill-slot group-data-[compact=true]/sb:hidden"><DraftCount client:idle /></span>}
                </a>
              );
            })}
          </div>
        </details>
      );
    })
  }
  <div class="mt-2 border-t border-sidebar-border pt-2">
    {
      (() => {
        const Icon = NAV_ICONS[SETTINGS_NAV.icon];
        return (
          <a href={SETTINGS_NAV.href} title={SETTINGS_NAV.label} class={linkClass(isCurrent(SETTINGS_NAV))} aria-current={isCurrent(SETTINGS_NAV) ? "page" : undefined}>
            <span class="relative"><Icon className="h-4 w-4" /></span>
            <span class="nav-label flex-1 group-data-[compact=true]/sb:hidden">{SETTINGS_NAV.label}</span>
          </a>
        );
      })()
    }
  </div>
</nav>

<style is:global>
  /* the chevron of an open group turns; a closed group shows the counter, an open one shows it on the link */
  .nav-group[open] > summary .nav-chevron { transform: rotate(180deg); }
  .nav-group[open] > summary .nav-summary-badge { display: none; }
</style>
