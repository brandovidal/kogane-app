---
import Layout from './Layout.astro'
import Sidebar from '@/layouts/components/navigation/Sidebar.astro'
import MobileNav from '@/layouts/components/navigation/MobileNav.astro'
import { CommandPalette } from '@/layouts/components/navigation/CommandPalette'
import { MonthNavigator } from '@/shared/components/navigation/MonthNavigator'
import { DailyPeriodHeader } from '@/features/daily/components/DailyPeriodHeader'
import { BudgetPeriodHeader } from '@/features/budget/components/BudgetPeriodHeader'
import { HistoryPeriodHeader } from '@/features/history/components/HistoryPeriodHeader'
import { NewExpenseDialog } from '@/features/new-expense/components/NewExpenseDialog'
import { UserMenu } from '@/features/auth/components/UserMenu'
import { NotificationBell } from '@/features/notifications/components/NotificationBell'
import { Toaster } from '@/ui/sonner'
import NavTooltipLayer from '@/layouts/components/navigation/NavTooltipLayer.astro'

interface Props {
  title?: string
  section?: string
  mainClass?: string
  mainMode?: 'scroll' | 'fill'
}

const { title = 'Kogane', section, mainClass, mainMode = 'scroll' } = Astro.props
const currentPath = Astro.url.pathname
const hasLocalPeriodControl = ['/resumen', '/calendario', '/recurrentes'].some((path) => currentPath === path)
---

<Layout title={title}>
  <div class="flex h-screen h-dvh min-h-[320px] min-w-0 overflow-hidden">
    <Sidebar currentPath={currentPath} />

    <div class="flex min-h-0 min-w-0 flex-1 flex-col overflow-hidden">
      <header class="flex h-16 shrink-0 items-center justify-between border-b px-4 md:px-6">
        <div class="flex min-w-0 flex-1 items-center gap-2">
          <MobileNav currentPath={currentPath} />
          <div class="flex min-w-0 flex-col">
            {section && (
              <span class="eyebrow hidden sm:block">
                <slot name="page-section">{section}</slot>
              </span>
            )}
            <div class="flex min-w-0 items-baseline gap-2.5">
              <h1 class="truncate text-lg font-semibold tracking-tight">
                <slot name="page-title">{title}</slot>
              </h1>
              <slot name="title-extra" />
            </div>
          </div>
        </div>
        <div class="flex shrink-0 items-center gap-1 sm:gap-3">
          <slot name="header-actions" />
          {currentPath === '/dia-a-dia' && <DailyPeriodHeader client:load />}
          {currentPath === '/presupuesto' && <BudgetPeriodHeader client:load />}
          {currentPath === '/configuracion/historial' && <HistoryPeriodHeader client:load />}
          <NotificationBell client:idle currentPath={currentPath} />
          <UserMenu client:load />
        </div>
      </header>

      <main
        class:list={[
          'min-h-0 min-w-0 flex-1 overflow-x-hidden overscroll-contain',
          mainMode === 'fill' ? 'flex flex-col overflow-hidden' : 'overflow-y-auto p-4 md:p-6',
          mainClass,
        ]}
      >
        {hasLocalPeriodControl && (
          <div class="mb-4 flex justify-end">
            <MonthNavigator client:idle />
          </div>
        )}
        <slot />
      </main>
      <NewExpenseDialog client:idle />
      <CommandPalette client:idle />
    </div>
  </div>
  <Toaster client:idle />
  <NavTooltipLayer />
</Layout>
