---
import Layout from "./Layout.astro";
import Sidebar from "@/layouts/components/navigation/Sidebar.astro";
import MobileNav from "@/layouts/components/navigation/MobileNav.astro";
import { CommandPalette } from "@/layouts/components/navigation/CommandPalette";
import { MonthNavigator } from "@/shared/components/navigation/MonthNavigator";
import { NewExpenseDialog } from "@/features/new-expense/components/NewExpenseDialog";
import { UserMenu } from "@/features/auth/components/UserMenu";
import { NotificationBell } from "@/features/notifications/components/NotificationBell";
import { Toaster } from "@/ui/sonner";
import NavTooltipLayer from "@/layouts/components/navigation/NavTooltipLayer.astro";

interface Props {
  title?: string;
  /** Small uppercase label above the title, e.g. "Gastos". */
  section?: string;
}

const { title = "Kogane", section } = Astro.props;
const currentPath = Astro.url.pathname;
// Views with their own month-based data get a local period control in the page body.
// Debt and fixed-cost views expose period filters; Ingresos has its own month/year selectors.
const hasLocalPeriodControl = [
  "/",
  "/resumen",
  "/calendario",
  "/tarjetas",
  "/dia-a-dia",
  "/recurrentes",
  "/categorias",
  "/plataformas",
  "/configuracion",
].some((path) => currentPath === path || (path === "/tarjetas" && currentPath.startsWith("/tarjetas/")));
---

<Layout title={title}>
  <div class="flex h-screen overflow-hidden">
    <Sidebar currentPath={currentPath} />

    <div class="flex flex-1 flex-col overflow-hidden">
      <header class="flex h-16 items-center justify-between border-b px-4 md:px-6">
        <div class="flex min-w-0 flex-1 items-center gap-2">
          <MobileNav currentPath={currentPath} />
          <div class="flex min-w-0 flex-col">
            {section && <span class="eyebrow hidden sm:block">{section}</span>}
            <div class="flex min-w-0 items-baseline gap-2.5">
              <h1 class="truncate text-lg font-semibold tracking-tight">{title}</h1>
              <slot name="title-extra" />
            </div>
          </div>
        </div>
        <div class="flex shrink-0 items-center gap-1 sm:gap-3">
          <slot name="header-actions" />
          <NotificationBell client:idle currentPath={currentPath} />
          <UserMenu client:load />
        </div>
      </header>

      <main class="flex-1 overflow-y-auto p-4 md:p-6">
        {hasLocalPeriodControl && (
          <div class="mb-4 flex justify-end">
            <MonthNavigator client:idle />
          </div>
        )}
        <slot />
      </main>
      <NewExpenseDialog client:idle />
      <CommandPalette client:idle />
    </div>
  </div>
  <Toaster client:idle />
  <NavTooltipLayer />
</Layout>
