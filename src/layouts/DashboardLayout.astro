---
import Layout from "./Layout.astro";
import Sidebar from "@/shared/components/Sidebar.astro";
import MobileNav from "@/shared/components/MobileNav.astro";
import { CommandPalette } from "@/shared/components/CommandPalette";
import { ThemeToggle } from "@/shared/components/ThemeToggle";
import { MonthNavigator } from "@/shared/components/MonthNavigator";
import { NewExpenseDialog } from "@/features/new-expense/components/NewExpenseDialog";
import { SalaryEditor } from "@/shared/components/SalaryEditor";
import { UserMenu } from "@/features/auth/components/UserMenu";
import { NotificationBell } from "@/features/notifications/components/NotificationBell";
import { Toaster } from "@/ui/sonner";

interface Props {
  title?: string;
}

const { title = "Kogane" } = Astro.props;
const currentPath = Astro.url.pathname;
// Views with their own month-based data get a local period control in the page body.
// Debt views already expose month and year inside their own filter panel.
const hasLocalPeriodControl = [
  "/",
  "/resumen",
  "/calendario",
  "/tarjetas",
  "/costos-fijos",
  "/dia-a-dia",
  "/recurrentes",
  "/categorias",
  "/plataformas",
  "/ingresos",
  "/configuracion",
].some((path) => currentPath === path || (path === "/tarjetas" && currentPath.startsWith("/tarjetas/")));
---

<Layout title={title}>
  <div class="flex h-screen overflow-hidden">
    <Sidebar currentPath={currentPath} />

    <div class="flex flex-1 flex-col overflow-hidden">
      <header class="flex h-16 items-center justify-between border-b px-4 md:px-6">
        <div class="flex items-center gap-2">
          <MobileNav currentPath={currentPath} />
          <h1 class="text-lg font-semibold">{title}</h1>
        </div>
        <div class="flex items-center gap-3">
          <SalaryEditor client:idle />
          <NotificationBell client:idle currentPath={currentPath} />
          <ThemeToggle client:idle />
          <UserMenu client:load />
        </div>
      </header>

      <main class="flex-1 overflow-y-auto p-4 md:p-6">
        {hasLocalPeriodControl && (
          <div class="mb-4 flex justify-end">
            <MonthNavigator client:idle />
          </div>
        )}
        <slot />
      </main>
      <NewExpenseDialog client:idle />
      <CommandPalette client:idle />
    </div>
  </div>
  <Toaster client:idle />
</Layout>
