---
// The menu of D41 drawn at build time (D102): groups are <details>, the link of the current page is marked here and the
// only live piece is the counter of Borrador. Compact mode and remembered groups are CSS and a tiny script (Sidebar)
import { ChevronRight } from "lucide-react";

import {
  DEFAULT_OPEN_GROUPS,
  NAV,
  SETTINGS_NAV,
} from "@/shared/constants/navigation";
import { isActivePath, isGroup } from "@/shared/utils/navigation";
import { type NavLink } from "@/shared/types/navigation";
import { NAV_ICONS } from "@/shared/constants/nav-icons";
import { DraftCount } from "@/features/drafts/components/DraftCount";

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;

const linkClass = (active: boolean) =>
  [
    "nav-link flex w-full items-center gap-3 rounded-lg px-3 py-2 text-sm font-medium transition-colors",
    "group-data-[compact=true]/sb:justify-center group-data-[compact=true]/sb:px-2",
    active
      ? "bg-sidebar-accent text-sidebar-accent-foreground"
      : "text-sidebar-foreground/70 hover:bg-sidebar-accent hover:text-sidebar-accent-foreground",
  ].join(" ");

const isCurrent = (link: NavLink) => isActivePath(link.href, currentPath);

// level 2: the active item adds a bar over the guide line of the group (D41 board 5)
const childClass = (active: boolean) =>
  [
    linkClass(active),
    "relative",
    active
      ? "font-semibold text-sidebar-foreground before:absolute before:-left-[9px] before:top-1.5 before:bottom-1.5 before:w-0.5 before:rounded-full before:bg-indigo-300 group-data-[compact=true]/sb:before:hidden"
      : "",
  ].join(" ");
---

<nav class="nav-menu flex-1 space-y-1 overflow-y-auto p-3">
  {NAV.map((entry) => {
    if (!isGroup(entry)) {
      const Icon = NAV_ICONS[entry.icon];
      return (
        <a
          href={entry.href}
          aria-label={entry.label}
          data-nav-tooltip-label={entry.label}
          data-nav-tooltip-description={entry.description}
          class={linkClass(isCurrent(entry))}
          aria-current={isCurrent(entry) ? "page" : undefined}
        >
          <span class="relative">
            <Icon className="h-4 w-4" />
          </span>
          <span class="nav-label flex-1 group-data-[compact=true]/sb:hidden">
            {entry.label}
          </span>
        </a>
      );
    }

    const GroupIcon = NAV_ICONS[entry.icon];
    const holdsCurrent = entry.children.some(isCurrent);
    const open = DEFAULT_OPEN_GROUPS.includes(entry.label) || holdsCurrent;
    const hasDrafts = entry.children.some((child) => child.badge === "drafts");
    return (
      <details
        class="nav-group"
        data-group={entry.label}
        data-current={holdsCurrent ? "true" : undefined}
        open={open}
      >
        <summary
          aria-label={entry.label}
          data-nav-tooltip-label={entry.label}
          data-nav-tooltip-description={entry.description}
          class={`${linkClass(false)} cursor-pointer list-none group-data-[compact=true]/sb:hidden [&::-webkit-details-marker]:hidden`}
        >
          <GroupIcon
            className={`nav-group-icon h-4 w-4${holdsCurrent ? " is-parent" : ""}`}
          />
          <span
            class={`nav-label flex-1 text-left${holdsCurrent ? " text-sidebar-foreground" : ""}`}
          >
            {entry.label}
          </span>
          {/* a closed group keeps the counter of Borrador in sight */}
          {hasDrafts && (
            <span class="nav-summary-badge">
              <DraftCount client:idle />
            </span>
          )}
          <ChevronRight className="nav-chevron h-4 w-4 transition-transform" />
        </summary>
        <div class="space-y-1 ml-4 border-l border-sidebar-border pl-2 group-data-[compact=true]/sb:ml-0 group-data-[compact=true]/sb:border-0 group-data-[compact=true]/sb:pl-0">
          {entry.children.map((child) => {
            const Icon = NAV_ICONS[child.icon];
            return (
              <a
                href={child.href}
                aria-label={child.label}
                data-nav-tooltip-label={child.label}
                data-nav-tooltip-description={child.description}
                class={childClass(isCurrent(child))}
                aria-current={isCurrent(child) ? "page" : undefined}
              >
                <span class="relative">
                  <Icon className="h-4 w-4" />
                  {child.badge === "drafts" && <DraftCount dot client:idle />}
                </span>
                <span class="nav-label flex-1 group-data-[compact=true]/sb:hidden">
                  {child.label}
                </span>
                {child.badge === "drafts" && (
                  <span class="nav-pill-slot group-data-[compact=true]/sb:hidden">
                    <DraftCount client:idle />
                  </span>
                )}
              </a>
            );
          })}
        </div>
      </details>
    );
  })}
  <div class="mt-2 border-t border-sidebar-border pt-2">
    {(() => {
      const Icon = NAV_ICONS[SETTINGS_NAV.icon];
      return (
        <a
          href={SETTINGS_NAV.href}
          aria-label={SETTINGS_NAV.label}
          data-nav-tooltip-label={SETTINGS_NAV.label}
          data-nav-tooltip-description={SETTINGS_NAV.description}
          class={linkClass(isCurrent(SETTINGS_NAV))}
          aria-current={isCurrent(SETTINGS_NAV) ? "page" : undefined}
        >
          <span class="relative">
            <Icon className="h-4 w-4" />
          </span>
          <span class="nav-label flex-1 group-data-[compact=true]/sb:hidden">
            {SETTINGS_NAV.label}
          </span>
        </a>
      );
    })()}
  </div>
</nav>

<style is:global>
  /* the chevron of an open group turns; a closed group shows the counter, an open one shows it on the link */
  .nav-group[open] > summary .nav-chevron {
    transform: rotate(90deg);
  }
  /* the parent of the active page keeps its place when the group is closed */
  .nav-group:not([open]) > summary .nav-group-icon.is-parent {
    color: var(--color-indigo-300);
  }
  /* closed groups show the soft total; an open group shows the solid count on each child */
  .nav-summary-badge > span,
  .nav-pill-slot > span {
    display: inline-block;
    min-width: 1.25rem;
    text-align: center;
  }
  .nav-summary-badge > span {
    background: color-mix(in oklab, var(--color-indigo-400) 22%, transparent);
    color: var(--color-indigo-200);
  }
  .nav-pill-slot > span {
    background: var(--sidebar-accent);
    color: var(--sidebar-foreground);
  }
  .nav-group[open] > summary .nav-summary-badge {
    display: none;
  }
</style>
