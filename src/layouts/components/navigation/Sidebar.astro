---
import { PanelLeftClose, PanelLeftOpen, Search } from "lucide-react";

import NavMenu from "@/layouts/components/navigation/NavMenu.astro";

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;
---

<aside
  data-sidebar
  data-compact="false"
  class="group/sb hidden border-r border-sidebar-border bg-sidebar transition-[width] md:flex md:w-64 md:flex-col data-[compact=true]:md:w-16"
>
  <div class="flex h-16 shrink-0 items-center justify-between border-b border-sidebar-border px-4 group-data-[compact=true]/sb:justify-center group-data-[compact=true]/sb:gap-1 group-data-[compact=true]/sb:px-0">
    <a
      href="/"
      aria-label="Kogane · Inicio"
      data-nav-tooltip-label="Kogane"
      data-nav-tooltip-description="Volver a Inicio."
      class="flex items-center gap-2 rounded-lg outline-none focus-visible:ring-2 focus-visible:ring-ring"
    >
      <img
        src="/kogane.webp"
        alt=""
        class="h-10 w-10 shrink-0 rounded-xl bg-white object-contain p-1 group-data-[compact=true]/sb:hidden"
      />
      <span
        aria-hidden="true"
        class="hidden size-9 items-center justify-center rounded-xl bg-white text-xl font-bold tracking-tight text-[#101114] group-data-[compact=true]/sb:flex"
      >
        K
      </span>
      <span class="text-lg font-bold text-sidebar-foreground group-data-[compact=true]/sb:hidden">
        Kogane
      </span>
    </a>
    <button
      type="button"
      data-sidebar-toggle
      data-sidebar-collapse
      class="inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-md outline-none hover:bg-sidebar-accent focus-visible:ring-2 focus-visible:ring-ring group-data-[compact=true]/sb:hidden"
      data-nav-tooltip-label="Compactar menú"
      data-nav-tooltip-description="Mostrar solo los iconos de navegación."
      aria-label="Compactar o expandir el menú"
    >
      <PanelLeftClose className="h-4 w-4 group-data-[compact=true]/sb:hidden" />
      <PanelLeftOpen className="hidden h-4 w-4 group-data-[compact=true]/sb:block" />
    </button>
  </div>
  <div class="shrink-0 px-3 pt-3 group-data-[compact=true]/sb:hidden">
    <button
      type="button"
      data-open-search
      aria-label="Buscar (Ctrl K)"
      class="flex h-9 w-full items-center gap-2 rounded-lg border border-sidebar-border bg-white/4 px-3 text-sm text-sidebar-foreground/60 outline-none transition-colors hover:bg-sidebar-accent focus-visible:ring-2 focus-visible:ring-ring"
    >
      <Search className="size-4" />
      <span class="flex-1 text-left">Buscar</span>
      <kbd class="rounded border border-sidebar-border px-1.5 text-[11px] leading-5">
        Ctrl K
      </kbd>
    </button>
  </div>
  <NavMenu currentPath={currentPath} />
  <div class="hidden shrink-0 border-t border-sidebar-border p-2 group-data-[compact=true]/sb:flex group-data-[compact=true]/sb:justify-center">
    <button
      type="button"
      data-sidebar-toggle
      data-sidebar-expand
      aria-label="Expandir menú"
      data-nav-tooltip-label="Expandir menú"
      class="inline-flex size-9 items-center justify-center rounded-lg text-sidebar-foreground/70 outline-none hover:bg-sidebar-accent hover:text-sidebar-accent-foreground focus-visible:ring-2 focus-visible:ring-ring"
    >
      <PanelLeftOpen className="size-4" />
    </button>
  </div>
</aside>

<script is:inline>
  (function () {
    const COMPACT_KEY = "kogane:sidebar-compact";
    const GROUPS_KEY = "kogane:nav-open:v2";
    const aside = document.querySelector("[data-sidebar]");
    if (!aside) return;
    const groups = aside.querySelectorAll("details[data-group]");
    const read = function (key) {
      try {
        return localStorage.getItem(key);
      } catch {
        return null;
      }
    };
    const write = function (key, value) {
      try {
        localStorage.setItem(key, value);
      } catch {
        /* not remembered */
      }
    };
    const stored = read(GROUPS_KEY);
    let saved = [];
    try {
      saved = JSON.parse(stored || "[]") || [];
    } catch {
      saved = [];
    }
    const opened = [];
    const current = [];
    groups.forEach(function (group) {
      if (group.open) opened.push(group.dataset.group);
      if (group.dataset.current === "true") current.push(group.dataset.group);
    });
    let openGroups =
      stored === null
        ? opened
        : saved.concat(
            current.filter(function (label) {
              return saved.indexOf(label) < 0;
            }),
          );

    const apply = function (compact) {
      aside.dataset.compact = compact ? "true" : "false";
      aside
        .querySelectorAll("[data-sidebar-toggle]")
        .forEach(function (button) {
          button.setAttribute(
            "aria-label",
            compact ? "Expandir menú" : "Compactar menú",
          );
          button.setAttribute("aria-expanded", compact ? "false" : "true");
        });
      groups.forEach(function (group) {
        group.open = compact || openGroups.indexOf(group.dataset.group) >= 0;
      });
    };
    apply(read(COMPACT_KEY) === "1");

    groups.forEach(function (group) {
      group.addEventListener("toggle", function () {
        if (aside.dataset.compact === "true") return;
        const label = group.dataset.group;
        openGroups = openGroups.filter(function (item) {
          return item !== label;
        });
        if (group.open) openGroups.push(label);
        write(GROUPS_KEY, JSON.stringify(openGroups));
      });
    });

    const search = aside.querySelector("[data-open-search]");
    if (search) {
      search.addEventListener("click", function () {
        window.dispatchEvent(new CustomEvent("kogane:open-search"));
      });
    }

    aside.querySelectorAll("[data-sidebar-toggle]").forEach(function (toggle) {
      toggle.addEventListener("click", function () {
        const compact = aside.dataset.compact !== "true";
        write(COMPACT_KEY, compact ? "1" : "0");
        apply(compact);
        const visibleToggle = aside.querySelector(
          compact ? "[data-sidebar-expand]" : "[data-sidebar-collapse]",
        );
        if (visibleToggle) visibleToggle.focus();
      });
    });
  })();
</script>
