---
import "@/styles/app-gradient.css";

interface Props {
  title?: string;
}

const { title = "Kogane" } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" href="/kogane.webp" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="App de seguimiento de gastos personales"
    />
    <title>{title === "Kogane" ? title : `${title} · Kogane`}</title>
  </head>
  <body class="min-h-screen antialiased">
    <slot />
    <script>
      import { themeStore } from "@/shared/stores/theme.store";
      themeStore.getState().initTheme();
    </script>
  </body>
</html>

<style is:global>
  @import "../styles/globals.css";
</style>
