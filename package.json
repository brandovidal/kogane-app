{
  "name": "kogane-app",
  "type": "module",
  "version": "0.0.1",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24.13.0"
  },
  "scripts": {
    "dev": "astro dev --mode dev",
    "build": "astro build",
    "preview": "node --env-file=.env ./node_modules/astro/bin/astro.mjs preview --port 3000",
    "astro": "astro",
    "format": "prettier --write \"src/**/*.{astro,css,js,jsx,json,md,ts,tsx}\" package.json eslint.config.js",
    "format:check": "prettier --check \"src/**/*.{astro,css,js,jsx,json,md,ts,tsx}\" package.json eslint.config.js",
    "lint": "eslint src",
    "generate-types": "wrangler types",
    "test": "vitest run",
    "test:watch": "vitest",
    "knip": "knip --no-progress",
    "api:types": "openapi-typescript ${API_DOCS_URL:-http://localhost:5560/docs-json} -o src/shared/api/schema.d.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.4.0",
    "@astrojs/node": "11.1.8",
    "@astrojs/react": "7.1.0",
    "@base-ui/react": "1.9.0",
    "@hookform/resolvers": "5.9.2",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-query": "5.104.3",
    "@tanstack/react-table": "8.21.3",
    "astro": "7.4.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "embla-carousel-react": "8.6.0",
    "lucide-react": "1.59.0",
    "openapi-fetch": "0.17.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.90.0",
    "recharts": "3.10.1",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "wrangler": "4.151.1",
    "zod": "4.6.7",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@eslint/js": "10.0.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-astro": "3.2.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "husky": "9.1.7",
    "jsdom": "30.1.3",
    "knip": "6.41.0",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.5"
  }
}
