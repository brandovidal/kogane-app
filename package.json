{
  "name": "kogane-app",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "astro dev --mode dev",
    "build": "astro build",
    "preview": "node --env-file=.env ./node_modules/astro/bin/astro.mjs preview --port 3000",
    "astro": "astro",
    "format": "prettier --write \"src/**/*.{astro,css,js,jsx,json,md,ts,tsx}\" package.json eslint.config.js",
    "format:check": "prettier --check \"src/**/*.{astro,css,js,jsx,json,md,ts,tsx}\" package.json eslint.config.js",
    "lint": "eslint src",
    "generate-types": "wrangler types",
    "test": "vitest run",
    "test:watch": "vitest",
    "knip": "knip --no-progress",
    "api:types": "openapi-typescript ${API_DOCS_URL:-http://localhost:5560/docs-json} -o src/shared/api/schema.d.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "@astrojs/cloudflare": "13.1.0",
    "@astrojs/node": "10.0.0",
    "@astrojs/react": "5.0.0",
    "@base-ui/react": "^1.8.0",
    "@hookform/resolvers": "5.2.2",
    "@tailwindcss/vite": "4.2.1",
    "@tanstack/react-query": "^5.103.2",
    "@tanstack/react-table": "^8.21.3",
    "astro": "6.0.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "embla-carousel-react": "^8.6.0",
    "lucide-react": "0.577.0",
    "openapi-fetch": "^0.17.0",
    "radix-ui": "1.4.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "7.71.2",
    "recharts": "3.8.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "3.5.0",
    "tailwindcss": "4.2.1",
    "wrangler": "4.72.0",
    "zod": "4.3.6",
    "zustand": "5.0.11"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.7",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.4",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "knip": "6.35.1",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "4.0.18"
  }
}
