{
	"compatibility_date": "2026-03-10",
	"compatibility_flags": [
		"global_fetch_strictly_public"
	],
	"name": "kogane-app",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"observability": {
		"logs": {
			"enabled": true,
			"invocation_logs": true
		},
		"traces": {
			"enabled": true
		}
	},
	"vars": {
		"API_URL": "https://kogane-api.up.railway.app"
	},
	"env": {
		"dev": {
			"name": "dev-kogane-app",
			"vars": {
				"API_URL": "https://kogane-api-dev.up.railway.app"
			}
		},
		"qa": {
			"name": "qa-kogane-app",
			"vars": {
				"API_URL": "https://kogane-api-qa.up.railway.app"
			}
		}
	}
}